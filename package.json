{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "build:widget": "vp build -c vite.widget.config.ts",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "test": "vp test run",
        "test:watch": "vp test watch",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed",
        "e2e:screenshots": "E2E_SCREENSHOTS=1 playwright test e2e/screenshots",
        "size": "size-limit",
        "realtime:smoke": "node e2e/support/realtime-smoke.mjs",
        "test:openwa-mock": "node --test e2e/support/openwa-mock.test.mjs",
        "openwa:smoke": "node scripts/openwa-smoke.mjs",
        "openwa:record": "node scripts/openwa-record.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/echo-react": "^2.5.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cn": "^0.4.0",
        "concurrently": "^10.0.3",
        "date-fns": "^4.4.0",
        "input-otp": "^1.4.2",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "pusher-js": "^8.6.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.2.0",
        "react-resizable-panels": "^4.14.1",
        "recharts": "3.8.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vaul": "^1.1.2",
        "vite": "^8.0.0",
        "zod": "^4.6.5"
