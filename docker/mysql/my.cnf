# MySQL 8.4 for PNE Chat on a small VPS (2 vCPU / 4-8 GB RAM, shared with PHP, Redis and Reverb). Mounted read-only into the
# `mysql` container as /etc/mysql/conf.d/pne.cnf. On a bigger server raise innodb_buffer_pool_size (about 25-50 % of the RAM
# you leave to MySQL) and max_connections.
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
# Production MySQL runs in UTC (analytics days and the application time zone assume it).
default-time-zone = '+00:00'

# Memory
innodb_buffer_pool_size = 512M
innodb_redo_log_capacity = 512M
innodb_log_buffer_size = 16M
tmp_table_size = 32M
max_heap_table_size = 32M
table_open_cache = 1024
# performance_schema alone costs several hundred MB on a small server
performance_schema = OFF

# Connections: php-fpm (up to FPM_MAX_CHILDREN) + queue + scheduler + Reverb + the CLI commands
max_connections = 150
skip-name-resolve
wait_timeout = 600

# Durability: every commit is flushed. There is no binary log (backups are dumps, see scripts/backup.sh); switch it on for
# point-in-time recovery or replication.
innodb_flush_log_at_trx_commit = 1
skip-log-bin

# Hardening
local_infile = OFF
mysqlx = OFF
log_error_verbosity = 2

[client]
default-character-set = utf8mb4
