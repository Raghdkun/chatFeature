# Caddy for PNE Chat (the `web` image target: this file + the public/ directory of the same build at /srv/public).
#
# Environment (set by compose.prod.yml from your .env):
#   APP_DOMAIN   the public host name, e.g. chat.example.com (its DNS record must point at this server)
#   CADDY_TLS    your e-mail address for Let's Encrypt (automatic HTTPS), or the word `internal` for Caddy's own local CA
#                (local tests and hosts without a public name; browsers show a certificate warning)
#
# What lives where:
#   static files   /build/*, /widget/v1/loader.js, /sw.js, /icons/*, favicons, robots.txt   served by Caddy from /srv/public
#   websocket      /app/*                                                                  Reverb (container `reverb`, port 8080)
#   everything else (pages, /api/*, /w/*.js, /embed/*, /c/*, /webhooks/*, /up ...)         PHP-FPM through a unix socket
# Reverb's publish API (/apps/*) is NEVER exposed: only the application calls it, inside the compose network.
# Security headers (CSP with a per-request nonce, HSTS over https, framing rules) are sent by the APPLICATION: Caddy adds none of
# them to dynamic responses, so nothing is duplicated or weakened.
{
	# Caddy's admin API stays on localhost inside the container (the container health check uses it); it is not published.
	admin localhost:2019
	# `tls internal` makes Caddy try to install its local root certificate into the container's trust store: pointless (and noisy) here.
	skip_install_trust
	# If a CDN or another proxy sits in front of Caddy, list its addresses here so the real client address is kept:
	#   servers {
	#       trusted_proxies static private_ranges
	#   }
}

{$APP_DOMAIN} {
	tls {$CADDY_TLS}

	encode zstd gzip

	# Access log to stdout, one JSON object per request. Cookie / Authorization headers are redacted by Caddy itself; the
	# signature of signed attachment URLs and the CSRF token headers are blanked as well.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace signature REDACTED
			}
			request>headers>X-Xsrf-Token replace REDACTED
			request>headers>X-Csrf-Token replace REDACTED
		}
	}

	header -Server
	header -Via
	header -Status

	# Largest request body: a chat attachment (Settings allows up to 25 MiB) plus multipart overhead. PHP enforces the exact limit.
	request_body {
		max_size 30MB
	}

	root * /srv/public

	# `route` keeps the order below literally (a plain list of handle blocks would be re-sorted by Caddy).
	route {
		# Never serve hidden files (ACME / well-known paths excepted), the storage link path or any PHP file but the front controller.
		@hidden {
			path_regexp hidden ^/\.
			not path /.well-known/*
		}
		respond @hidden 404

		@storage path /storage /storage/*
		respond @storage 404

		@stray_php {
			path *.php
			not path /index.php
		}
		respond @stray_php 404

		# Reverb's publish / control API is internal only.
		@reverb_api path /apps /apps/*
		respond @reverb_api 404

		# Websocket (wss://<domain>/app/<key>). Caddy upgrades the connection by itself; Reverb checks the Origin header against
		# REVERB_ALLOWED_ORIGINS and the host of APP_URL. flush_interval -1 sends frames immediately.
		@reverb path /app/*
		handle @reverb {
			reverse_proxy reverb:8080 {
				flush_interval -1
				transport http {
					dial_timeout 5s
				}
			}
		}

		# Built assets have content hashes in their names: cache them for a year.
		handle /build/* {
			header Cache-Control "public, max-age=31536000, immutable"
			header X-Content-Type-Options nosniff
			file_server
		}

		# The widget loader has no hash in its name: a short cache, so a new release reaches embedded sites within minutes.
		# (/w/<key>.js, the per-widget script, is generated by PHP with its own Cache-Control and is never cached here.)
		handle /widget/v1/loader.js {
			header Cache-Control "public, max-age=300"
			header X-Content-Type-Options nosniff
			file_server
		}

		# A service worker must always be revalidated.
		handle /sw.js {
			header Cache-Control "no-cache"
			header X-Content-Type-Options nosniff
			file_server
		}

		handle /icons/* {
			header Cache-Control "public, max-age=604800"
			header X-Content-Type-Options nosniff
			file_server
		}

		# Native sign-in endpoints take a tiny JSON body: cap it at the edge as well (the framework parses a body before its own 8 KiB check).
		handle /api/v1/auth/* {
			request_body {
				max_size 16KB
			}
			php_fastcgi unix//run/php/php-fpm.sock {
				root /var/www/html/public
				dial_timeout 5s
				read_timeout 70s
				write_timeout 70s
			}
		}

		# Everything else: an existing file of public/ (favicon, robots.txt ...) is served directly, anything else goes to index.php.
		handle {
			php_fastcgi unix//run/php/php-fpm.sock {
				root /var/www/html/public
				dial_timeout 5s
				read_timeout 70s
				write_timeout 70s
			}
			file_server
		}
	}
}
