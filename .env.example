# Comma-separated proxy addresses (or *) to trust X-Forwarded-* from; leave empty when not behind a proxy.
TRUSTED_PROXIES=

APP_NAME="PNE Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatfeature
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Disk (config/filesystems.php) for chat image attachments; private, served only through signed URLs.
CHAT_ATTACHMENTS_DISK=local

# --- Install / setup wizard -------------------------------------------------------------
# `php artisan chat:bootstrap-secrets` generates APP_KEY, REVERB_*, VAPID_* and SETUP_TOKEN when empty.
# SETUP_TOKEN is the one-time takeover guard for /setup. It is only skipped for APP_ENV=local requests that come
# straight from this machine (127.0.0.1 / ::1, no proxy headers); anywhere else it is required.
SETUP_TOKEN=
# APP_INSTALLED=true   # optional: treat the app as installed even without storage/app/installed.lock
# APP_INSTALLED=false  # optional: make the testing environment behave as "not installed"
# INSTALL_STATE_DIR=   # optional: where install-state.json / installed.lock live (default storage/app)

# Non-interactive install: `php artisan chat:install --mode=local`
# INSTALL_ADMIN_NAME="Administrator"
# INSTALL_ADMIN_EMAIL=admin@example.com
# INSTALL_ADMIN_PASSWORD=
# INSTALL_APP_NAME="PNE Chat"
# INSTALL_APP_URL=http://localhost:8000
# INSTALL_LOCALE=en
# INSTALL_TIMEZONE=UTC
# INSTALL_IDLE_TIMEOUT_MINUTES=120

# --- Realtime (Reverb) and Web Push ----------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public address clients connect to (behind Caddy: your domain, 443, https).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Optional: where the Reverb process listens (Docker: 0.0.0.0) and where this app publishes events (Docker: reverb / 8080 / http).
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_PUBLISH_HOST=
# REVERB_PUBLISH_PORT=
# REVERB_PUBLISH_SCHEME=
# REVERB_PUBLISH_CONNECT_TIMEOUT=2
# REVERB_PUBLISH_TIMEOUT=5
# Extra hosts allowed to open a websocket (comma separated). APP_URL's host is always allowed. Never *.
# REVERB_ALLOWED_ORIGINS=
# REVERB_MAX_REQUEST_SIZE=262144
# REVERB_APP_MAX_MESSAGE_SIZE=10000
# REVERB_APP_PING_INTERVAL=60
# REVERB_APP_ACTIVITY_TIMEOUT=30
# REVERB_APP_MAX_CONNECTIONS=
# REVERB_APP_RATE_LIMITING_ENABLED=true
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=120
# REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
# REVERB_SCALING_ENABLED=false
# REVERB_SCALING_CHANNEL=reverb
# REALTIME_QUEUE=
# REALTIME_AUTH_PER_TOKEN=30
# REALTIME_AUTH_PER_NETWORK=120

# Presence (P5): where agents' live status is kept. Default: redis when CACHE_STORE / QUEUE_CONNECTION / SESSION_DRIVER is redis, else database.
# The Redis store needs the phpredis client (REDIS_CLIENT=phpredis); predis is not installed.
# PRESENCE_STORE=redis
# PRESENCE_HEARTBEAT_WINDOW=90
# PRESENCE_AUTO_AWAY_MINUTES=5
# PRESENCE_REDIS_CONNECTION=default
# PRESENCE_REDIS_PREFIX=presence:

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# PUSH_QUEUE=             # queue name for push jobs (default queue)
# PUSH_FCM_ENABLED=false  # the FCM stub only logs
# Optional: restrict which push services a browser's subscription may point at (comma separated host patterns; empty = any PUBLIC https host)
# PUSH_ALLOWED_HOSTS=
# The queue's retry_after must exceed the longest job timeout (150 s)
# DB_QUEUE_RETRY_AFTER=300
# REDIS_QUEUE_RETRY_AFTER=300

# WhatsApp (P6): disk for stored inbound images (private).
# WHATSAPP_MEDIA_DISK=local

# pizzasys auth events consumer (php artisan chat:auth:consume-nats). Optional: sessions are also re-verified
# against the portal on a short TTL, NATS only makes revocations faster. In auth mode 2 the consumer follows the
# ACTIVE auth environment's NATS address (Settings > Auth); the NATS_* values below are only the standalone/dev
# fallback and are ignored in production once an environment is configured (NATS_TLS_CA_FILE still applies).
NATS_ENABLED=false
NATS_URL=
NATS_TOKEN=
NATS_STREAM=AUTH_EVENTS
NATS_ENSURE_STREAM=true
NATS_ENVIRONMENT_KEY=production
# CA bundle the NATS server certificate (and host name) is verified against; empty = the system CA store.
NATS_TLS_CA_FILE=
# Config-backed settings only: set to false to talk to a NATS server with a self-signed certificate (the active auth
# environment's own "verify TLS" switch applies in pizzasys mode).
# NATS_VERIFY_TLS=true
# tests only: NATS_TEST_URL=nats://127.0.0.1:4222 php artisan test --filter=NatsIntegrationTest

# --- Outbound calls to the auth portal / its NATS server (pizzasys mode) --------------------------------------------
# Addresses typed into Settings > Auth must be PUBLIC hosts: loopback, private (10.x, 172.16-31.x, 192.168.x, fc00::/7),
# CGNAT and link-local targets are refused, so the portal "Test connection" cannot be aimed at your internal network or
# the cloud metadata service. Set this to true ONLY when the portal really lives on a private network (for example a
# Docker network or a VPN). APP_ENV=local always allows private hosts.
PORTAL_ALLOW_PRIVATE_HOSTS=false
