# Comma-separated proxy addresses (or *) to trust X-Forwarded-* from; leave empty when not behind a proxy.
TRUSTED_PROXIES=

APP_NAME="PNE Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatfeature
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Install / setup wizard -------------------------------------------------------------
# `php artisan chat:bootstrap-secrets` generates APP_KEY, REVERB_*, VAPID_* and SETUP_TOKEN when empty.
# SETUP_TOKEN is the one-time takeover guard for /setup (not asked for when APP_ENV=local).
SETUP_TOKEN=
# APP_INSTALLED=true   # optional: treat the app as installed even without storage/app/installed.lock
# APP_INSTALLED=false  # optional: make the testing environment behave as "not installed"
# INSTALL_STATE_DIR=   # optional: where install-state.json / installed.lock live (default storage/app)

# Non-interactive install: `php artisan chat:install --mode=local`
# INSTALL_ADMIN_NAME="Administrator"
# INSTALL_ADMIN_EMAIL=admin@example.com
# INSTALL_ADMIN_PASSWORD=
# INSTALL_APP_NAME="PNE Chat"
# INSTALL_APP_URL=http://localhost:8000
# INSTALL_LOCALE=en
# INSTALL_TIMEZONE=UTC
# INSTALL_IDLE_TIMEOUT_MINUTES=120

# --- Realtime (Reverb) and Web Push ----------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# pizzasys auth events consumer (php artisan chat:auth:consume-nats). Optional: sessions are also re-verified
# against the portal on a short TTL, NATS only makes revocations faster. The active auth environment's NATS
# settings (Settings > Auth) take precedence when auth mode 2 is configured.
NATS_ENABLED=false
NATS_URL=
NATS_TOKEN=
NATS_STREAM=AUTH_EVENTS
NATS_ENSURE_STREAM=true
NATS_ENVIRONMENT_KEY=production
NATS_TLS_CA_FILE=
# tests only: NATS_TEST_URL=nats://127.0.0.1:4222 php artisan test --filter=NatsIntegrationTest

