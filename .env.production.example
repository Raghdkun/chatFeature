# =====================================================================================================================
# PNE Chat: production environment for compose.prod.yml
#
#   cp .env.production.example .env && chmod 600 .env        (or: scripts/init-env.sh --domain chat.example.com --email you@example.com)
#
# This ONE file is read twice: by Docker Compose (for ${...} in compose.prod.yml) and by every application container
# (`env_file: .env`). It holds secrets: never commit it, never paste it into a chat or a ticket, and keep a copy in your
# password manager (losing APP_KEY makes every encrypted setting in the database unreadable).
# Values with spaces need double quotes. `${NAME}` is expanded by Compose from other lines of this file.
# Only names the application really reads are listed here (checked against config/*.php).
# =====================================================================================================================

# ---- Docker Compose and Caddy ----------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=pnechat
# Optional parts, comma separated: whatsapp (the OpenWA gateway), nats (a NATS server). Example: COMPOSE_PROFILES=whatsapp
COMPOSE_PROFILES=
# The public host name of this site. Its DNS A (and AAAA) record must point at this server BEFORE the first start.
APP_DOMAIN=chat.example.com
# Automatic HTTPS: your e-mail address (Let's Encrypt sends expiry notices there). Write `internal` instead for Caddy's own
# local CA (local tests, a host without a public name): browsers then warn about the certificate.
CADDY_TLS=you@example.com
# Published ports. Leave 80 / 443 on a real server; other values are for local tests only.
HTTP_PORT=80
HTTPS_PORT=443
# Image tag: `up -d --build` tags what it builds with this. Use a new tag per release (for example 2026-10-02) to roll back by tag.
PNE_TAG=latest

# Memory ceilings per container (Docker kills a container that goes above its limit). Defaults suit a 4 GB server; docs: sizing.
# APP_MEM_LIMIT=1g
# QUEUE_MEM_LIMIT=512m
# SCHEDULER_MEM_LIMIT=384m
# REVERB_MEM_LIMIT=512m
# NATS_CONSUMER_MEM_LIMIT=256m
# MYSQL_MEM_LIMIT=1g
# REDIS_MEM_LIMIT=512m
# CADDY_MEM_LIMIT=256m
# OPENWA_MEM_LIMIT=1536m
# Redis stops accepting writes (it never evicts) above this size.
# REDIS_MAXMEMORY=384mb
# php-fpm workers (about 40-60 MB each under load). The defaults are 16 / 4 / 2 / 8.
# FPM_MAX_CHILDREN=16
# FPM_START_SERVERS=4
# FPM_MIN_SPARE_SERVERS=2
# FPM_MAX_SPARE_SERVERS=8
# Cache the configuration and the routes at every container start (true). Set false only to debug.
# APP_OPTIMIZE=true

# ---- Application -------------------------------------------------------------------------------------------------------
APP_NAME="PNE Chat"
APP_ENV=production
APP_DEBUG=false
# Generated by `scripts/init-env.sh --secrets` (or `php artisan chat:bootstrap-secrets`); do not change it after the install.
APP_KEY=
# The public https origin, no trailing slash and no port on a real server. It must equal what the wizard saves as "Application URL".
APP_URL=https://${APP_DOMAIN}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
BCRYPT_ROUNDS=12

# One-time takeover guard of the setup wizard (/setup). Generated by `scripts/init-env.sh --secrets`; REMOVE the line (or empty it)
# after the installation is finished: /setup answers 404 from then on, the token is not needed again.
SETUP_TOKEN=

# Behind Caddy php-fpm already receives the real client address and the https scheme. Set this only when ANOTHER proxy or CDN
# (Cloudflare, a load balancer) sits in front of Caddy: its addresses, comma separated (or * if Caddy is only reachable through it).
# Empty trusts nothing.
TRUSTED_PROXIES=

# ---- Database (MySQL 8.4, container `mysql`) -------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=chatfeature
DB_USERNAME=chatfeature
# openssl rand -hex 24
DB_PASSWORD=

# ---- Redis (container `redis`): cache, queue, sessions, agent presence --------------------------------------------------
# phpredis is built into the image. The queue's retry_after is 300 s; every `queue:work --timeout` stays below it.
REDIS_CLIENT=phpredis
# openssl rand -hex 24
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Minutes of inactivity before a dashboard session ends; keep it at 30 or more (the dashboard pings every 20 minutes).
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
# Lifetime of staff API tokens (native app sign-in) in minutes: 43200 = 30 days.
SANCTUM_EXPIRATION_MINUTES=43200

# ---- Realtime (Reverb, container `reverb`) -------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# Generated by `scripts/init-env.sh --secrets`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The PUBLIC address browsers connect to (wss://<domain>/app/<key> through Caddy). On a real server: your domain, 443, https.
# (Where Reverb listens and where the app publishes is fixed in compose.prod.yml: 0.0.0.0:8080 and reverb:8080.)
REVERB_HOST=${APP_DOMAIN}
REVERB_PORT=443
REVERB_SCHEME=https
# Extra hosts (comma separated) allowed to open a websocket besides the host of APP_URL. NEVER `*`.
# REVERB_ALLOWED_ORIGINS=
# The image has ext-uv, so Reverb is not limited to ~1000 sockets; set a cap only to protect a small server (for example 3000).
# REVERB_APP_MAX_CONNECTIONS=

# ---- Web Push (VAPID) -----------------------------------------------------------------------------------------------------
# Generated by `scripts/init-env.sh --secrets`. Without both keys push notifications are off (the dashboard still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or an https URL that identifies you to the push services.
VAPID_SUBJECT=mailto:you@example.com

# ---- E-mail (offline tickets, replies to visitors) -------------------------------------------------------------------------
# Port 25 is usually blocked on VPS networks: use your mail provider's submission port (587 with STARTTLS = MAIL_SCHEME smtp,
# or 465 with implicit TLS = MAIL_SCHEME smtps). MAIL_MAILER=log only writes mails to the log (no delivery).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=chat@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Security headers ----------------------------------------------------------------------------------------------------
# Content-Security-Policy of the dashboard: report-only (log violations, block nothing) | enforce | off. The policy has not been checked
# in a real browser yet: start with report-only, run the checklist in docs/testing.md ("CSP verification checklist"), then set enforce.
CSP_MODE=report-only
# HSTS lifetime in seconds, sent only over https (0 = never). 31536000 = one year.
# SECURITY_HSTS_MAX_AGE=31536000

# ---- Authentication portal (mode 2, pizzasys) and private networks -------------------------------------------------------
# Addresses typed into Settings > Auth must be PUBLIC hosts. Set true ONLY when the portal or its NATS server lives on a private
# network (VPN, another Docker network), or when you run the OpenWA container (its address http://openwa:2785 is private).
# It is one switch for all of them: it lifts only the "private network" refusal of the outbound address guard.
PORTAL_ALLOW_PRIVATE_HOSTS=false
# CA bundle (a path INSIDE the containers) for a NATS server with a private certificate authority. Empty = system store.
# NATS_TLS_CA_FILE=

# ---- WhatsApp (OpenWA), only with COMPOSE_PROFILES=whatsapp ---------------------------------------------------------------------
# HMAC key for the gateway's stored API keys; set it BEFORE the gateway starts the first time. openssl rand -hex 32
OPENWA_API_KEY_PEPPER=
# Another image (by digest!) only after you tested it: node scripts/openwa-smoke.mjs, docs/whatsapp-openwa.md ("Versions").
# OPENWA_IMAGE=

# ---- First installation without the browser wizard (php artisan chat:install --mode=local) ------------------------------------
# Read ONLY by `chat:install`: remove them again after the install (the admin password stays in your shell history and `docker inspect`).
# INSTALL_ADMIN_NAME="Administrator"
# INSTALL_ADMIN_EMAIL=admin@example.com
# INSTALL_ADMIN_PASSWORD=
# INSTALL_APP_NAME="PNE Chat"
# INSTALL_APP_URL=https://${APP_DOMAIN}
# INSTALL_LOCALE=en
# INSTALL_TIMEZONE=UTC
# INSTALL_IDLE_TIMEOUT_MINUTES=120

# After a successful install: treat the application as installed even if the `storage` volume (installed.lock) is ever lost,
# so /setup cannot reopen. Never set it before the installation: it would skip the wizard.
# APP_INSTALLED=true
